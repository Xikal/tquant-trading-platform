APP_NAME=A股短线做T量化系统
API_PREFIX=/api
DATABASE_URL=sqlite:///./data/t_quant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_DATA_SOURCE=akshare_eastmoney
HTTP_TIMEOUT=12
AUTH_SECRET_KEY=change_me_to_a_long_random_secret
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_MINUTES=720
AUTH_REFRESH_TOKEN_DAYS=90

# Agent / Hermes / MCP 只读工具入口
AGENT_PROVIDER=none
AGENT_API_BASE=http://127.0.0.1:18090/api
AGENT_API_TOKEN=change_me_agent_read_token
AGENT_TIMEOUT_SECONDS=10
NOTIFICATION_FEISHU_WEBHOOK_URL=
NOTIFICATION_FEISHU_SECRET=
NOTIFICATION_SIGNAL_COOLDOWN_MINUTES=240
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
HERMES_API_URL=
HERMES_API_KEY=

# 模拟盘自动交易（默认开启；仅交易时段实际执行）
PAPER_AUTO_TRADING_ENABLED=true
PAPER_AUTO_TRADING_INTERVAL=120
PAPER_AUTO_TRADING_MAX_ORDERS=5
PAPER_AUTO_TRADING_DRY_RUN=false
PAPER_AUTO_TRADING_MIN_SCORE=75

# 模拟盘绩效归档
PAPER_PERF_ARCHIVE_ENABLED=true
PAPER_PERF_ARCHIVE_TIME=15:05
PAPER_PERF_AI_REPORT_ENABLED=true

# 月度生产策略样本外验证
STRATEGY_VALIDATION_MONTHLY_ENABLED=true
STRATEGY_VALIDATION_MONTHLY_LOOKBACK_DAYS=252
STRATEGY_VALIDATION_MONTHLY_MAX_SIGNALS_PER_DAY=8
