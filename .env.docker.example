APP_PORT=8000
APP_NAME=维斯量化交易平台
APP_ENVIRONMENT=production
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:18080","http://127.0.0.1:18080","http://localhost:18090","http://127.0.0.1:18090"]
DEFAULT_DATA_SOURCE=akshare_eastmoney
HTTP_TIMEOUT=12
MARKET_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=20
MARKET_PROVIDER_CIRCUIT_COOLDOWN_SECOND_SECONDS=45
MARKET_PROVIDER_CIRCUIT_COOLDOWN_MAX_SECONDS=90
MARKET_QUOTE_ASYNC_PROVIDER_ENABLED=true
MARKET_QUOTE_ASYNC_PROVIDER_CHUNK_SIZE=60
MARKET_QUOTE_ASYNC_PROVIDER_CONCURRENCY=4
BFF_WORKSPACE_TIMEOUT_SECONDS=8
APP_WORKERS=1
WEB_DB_POOL_SIZE=4
WEB_DB_MAX_OVERFLOW=4
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=2
ANALYTICS_DB_POOL_SIZE=4
ANALYTICS_DB_MAX_OVERFLOW=4
WEB_RUNTIME_BACKGROUND_JOBS_ENABLED=false
RUNTIME_BACKGROUND_JOBS_ENABLED=false
PAPER_AUTO_TRADING_ENABLED=false
PLATFORM_AUTOPILOT_ENABLED=true
TQUANT_RESEARCH_JOBS_ENABLED=false
TQUANT_ML_JOBS_ENABLED=false
TQUANT_FACTOR_JOBS_ENABLED=false
TQUANT_STRATEGY_EVOLUTION_ENABLED=false
WEB_TQUANT_ANALYTICS_ENABLED=false
ANALYTICS_WORKER_TQUANT_ANALYTICS_ENABLED=true
TQUANT_DUCKDB_THREADS=2
RUNTIME_WORKER_EMBED_SCHEDULER=false
RUNTIME_SCHEDULER_LEADER_LOCK_TTL_SECONDS=60
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3
APP_MEM_LIMIT=768m
MYSQL_MEM_LIMIT=1024m
RUNTIME_WORKER_MEM_LIMIT=768m
RUNTIME_SCHEDULER_MEM_LIMIT=640m
ANALYTICS_WORKER_MEM_LIMIT=512m
BACKTEST_WORKER_MEM_LIMIT=512m
HTTPS_REQUIRED=1
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_INSECURE_HTTP_COOKIE=false

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=t_quant
MYSQL_USER=tquant_app
MYSQL_PASSWORD=change_me_app
MYSQL_SLOW_QUERY_LOG=ON
MYSQL_LONG_QUERY_TIME=0.2
DATABASE_URL=mysql+mysqldb://tquant_app:change_me_app@mysql:3306/t_quant?charset=utf8mb4
# Fallback only if mysqlclient is unavailable:
# DATABASE_URL=mysql+pymysql://tquant_app:change_me_app@mysql:3306/t_quant?charset=utf8mb4
AUTH_SECRET_KEY=replace_with_64_plus_chars_auth_secret_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TQUANT_SETTINGS_ENCRYPTION_KEY=replace_with_different_64_plus_chars_settings_secret_bbbbbbbbbbbbbbbbbbbbbbbb
GLOBAL_RATE_LIMIT_BACKEND=redis
TQUANT_INTERNAL_SERVICE_TOKEN=replace_with_64_plus_chars_internal_service_token_cccccccccccccccccccccccc
