# Copy this file to .env.deploy.local and fill in local-only deployment secrets.
# .env.deploy.local is intentionally git-ignored.

CLOUD_HOST=
CLOUD_USER=ubuntu
CLOUD_SSH_KEY=
# CLOUD_PASSWORD=

CLOUD_DOMAIN=weisilianghua.cloud
CLOUD_CERT_EMAIL=admin@weisilianghua.cloud
# Default public UI/health entry used by deploy verification.
# Keep CLOUD_DOMAIN for certificate/nginx config; set this to the stable public entry.
CLOUD_PUBLIC_BASE_URL=https://43.143.243.97
CLOUD_PROJECT_DIR=/home/ubuntu/gupiao-upload
CLOUD_APP_PORT=18090

# safe | fast | full
DEFAULT_DEPLOY_MODE=safe

# auto | frontend-next | frontend-legacy | backend-api | db-migration | worker | go | ops | all
# auto detects changed files with scripts/deploy_scope.py. frontend-next uploads
# frontend-next/dist and skips backend/db/worker restarts.
DEPLOY_TARGET_SCOPE=auto
DEPLOY_COMPOSE_TOPOLOGY=separated
# In separated topology, frontend/API use docker-compose.separated.yml while
# migration, runtime workers, and Go services continue to use docker-compose.mysql.yml.
BACKEND_API_COMPOSE_FILE=docker-compose.separated.yml
FRONTEND_COMPOSE_FILE=docker-compose.separated.yml
DB_MIGRATION_COMPOSE_FILE=docker-compose.mysql.yml
RUNTIME_COMPOSE_FILE=docker-compose.mysql.yml
GO_COMPOSE_FILE=docker-compose.mysql.yml
DEPLOY_FRONTEND_NEXT_REQUIRED=1
DEPLOY_ALLOW_LEGACY_FRONTEND=0

# delta-package uploads only changed/new files when the remote manifest is valid.
# package-only remains the automatic fallback and can be set explicitly to disable delta upload.
# git-inplace/git-clone are explicit opt-in modes and depend on remote GitHub connectivity.
DEPLOY_SYNC_MODE=delta-package
DEPLOY_GIT_REMOTE_URL=https://github.com/Xikal/tquant-trading-platform.git

# auto prefers prebuilt images when all required refs are provided, otherwise falls back to remote build.
# Set to 1 to require prebuilt images and fail fast when a required ref is missing.
# Build refs with scripts/build_prebuilt_images.sh, then pass them to quick_cloud_deploy.sh.
DEPLOY_PREBUILT_IMAGES_ENABLED=auto
# Optional analytics-worker profile. Keep 0 for normal small-host deploys; set
# 1 only when the release must start and verify DuckDB/PyArrow analytics tasks.
DEPLOY_WITH_ANALYTICS_WORKER=0
# Backtest UI is hidden and backtest-worker is disabled by default on small hosts.
# Set to 1 only for a temporary research/backtest run.
DEPLOY_WITH_BACKTEST_WORKER=0
# DEPLOY_PREBUILT_WEB_IMAGE_REF=registry.example.com/tquant-web:<sha>
# DEPLOY_PREBUILT_ANALYTICS_IMAGE_REF=registry.example.com/tquant-analytics:<sha>
# DEPLOY_PREBUILT_GO_BFF_IMAGE_REF=registry.example.com/tquant-go-bff:<sha>
# DEPLOY_PREBUILT_GO_MARKET_READ_IMAGE_REF=registry.example.com/tquant-go-market-read:<sha>
# DEPLOY_PREBUILT_GO_SCAN_IMAGE_REF=registry.example.com/tquant-go-scan-worker:<sha>

# One-click deploy preflight keeps deploys predictable on small cloud instances.
# It removes old upload packages/temp hotpatch dirs, checks disk, keeps Docker volumes,
# avoids destructive image prune -a, and creates a temporary swap file only when needed.
RUN_REMOTE_PREFLIGHT=1
RUN_REMOTE_SAFE_CLEANUP=1
REMOTE_MIN_FREE_GB=8
REMOTE_MIN_SWAP_MB=2048
REMOTE_TEMP_SWAP_PATH=/swapfile-codex-deploy
REMOTE_TEMP_SWAP_MB=2048
REMOTE_REMOVE_TEMP_SWAP_AFTER_DEPLOY=1

# Single-host MySQL and SQLAlchemy pool budget. Defaults keep total possible app-side
# connections well below MYSQL_MAX_CONNECTIONS while allowing explicit override.
MYSQL_MAX_CONNECTIONS=120
MYSQL_BINLOG_EXPIRE_LOGS_SECONDS=259200
MYSQL_MAX_BINLOG_SIZE=256M
WEB_DB_POOL_SIZE=4
WEB_DB_MAX_OVERFLOW=4
APP_WORKERS=1
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=2
SCHEDULER_DB_POOL_SIZE=2
SCHEDULER_DB_MAX_OVERFLOW=2
ANALYTICS_DB_POOL_SIZE=4
ANALYTICS_DB_MAX_OVERFLOW=4
# Set to true during deploy/cutover validation or market-open pressure to pause
# analytics/backtest/data-repair low-priority task claims. Leave task list empty
# unless an operator needs to override docker-compose.mysql.yml defaults.
RUNTIME_LOW_PRIORITY_TASKS_PAUSED=false
RUNTIME_LOW_PRIORITY_TASK_TYPES=

# Small single-host runtime budget. Compact mode keeps startup and background
# refreshes from competing with interactive reads; it does not change strategy
# scoring or production ordering.
RUNTIME_BACKGROUND_COMPACT_MODE_ENABLED=true
RUNTIME_STARTUP_CACHE_PREWARM_ENABLED=false
RUNTIME_STARTUP_HISTORY_PREWARM_ENABLED=false
RUNTIME_WORKER_POLL_INTERVAL_SECONDS=10
ANALYTICS_WORKER_POLL_INTERVAL_SECONDS=10
RUNTIME_WORKER_EMBED_SCHEDULER=false
RUNTIME_SCHEDULER_LEADER_LOCK_TTL_SECONDS=60
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=3
APP_MEM_LIMIT=768m
MYSQL_MEM_LIMIT=1024m
RUNTIME_WORKER_MEM_LIMIT=768m
RUNTIME_SCHEDULER_MEM_LIMIT=640m
ANALYTICS_WORKER_MEM_LIMIT=512m
BACKTEST_WORKER_MEM_LIMIT=512m
RUNTIME_LOW_BUY_FULL_SCAN_INTERVAL_SECONDS=7200
RUNTIME_WATCHLIST_REFRESH_INTERVAL_SECONDS=180
RUNTIME_MARKET_REGIME_REFRESH_INTERVAL_SECONDS=900
RUNTIME_QUOTE_CACHE_REFRESH_INTERVAL_SECONDS=180
RUNTIME_HOURLY_MARKET_SNAPSHOT_INTERVAL_SECONDS=900
RUNTIME_MATERIALIZATION_REFRESH_INTERVAL_SECONDS=900
RUNTIME_DAILY_BAR_REFRESH_INTERVAL_SECONDS=900
RUNTIME_LATEST_DATA_WATCHDOG_INTERVAL_SECONDS=900
RUNTIME_MARKET_REVIEW_INTERVAL_SECONDS=900
RUNTIME_PAPER_PERF_ARCHIVE_INTERVAL_SECONDS=900
RUNTIME_AGENT_DAILY_REPORT_INTERVAL_SECONDS=900

# Comma-separated legacy routes served by frontend-next during cutover.
# Leave empty for normal deploys. Example:
# FRONTEND_NEXT_CUTOVER_PATHS=monitor,monitor/market,paper
FRONTEND_NEXT_CUTOVER_PATHS=

# Backtest worker can prefer daily_bars Parquet for historical bar scans after
# manifests are generated. Disabled by default; fallback keeps current behavior.
BACKTEST_WORKER_TQUANT_ANALYTICS_ENABLED=true
BACKTEST_PARQUET_DAILY_BARS_ENABLED=false
BACKTEST_PARQUET_DAILY_BARS_FALLBACK_TO_MYSQL=true
BACKTEST_PARQUET_DAILY_BARS_MANIFEST=latest
