{
  "name": "frontend-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" --max-warnings=0 && npm run check:refactor && npm run check:css && npm run check:boundary && npm run check:bundle-budget",
    "check:refactor": "node ./scripts/check-refactor-guard.mjs",
    "check:css": "node ./scripts/check-css-guard.mjs",
    "check:boundary": "node ./scripts/check-boundary-guard.mjs",
    "check:bundle-budget": "node ./scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../docs/contracts/openapi.json -o src/generated/api-types.ts",
    "api:check": "npm run api:generate && npm run typecheck",
    "e2e": "playwright test",
    "perf:compare": "node ./scripts/perf-profile.mjs",
    "chunk:profile": "node ./scripts/chunk-profile.mjs",
    "screenshot:parity": "node ./scripts/screenshot-parity.mjs",
    "api:parity": "node ./scripts/api-parity.mjs",
    "request:trace": "node ./scripts/request-trace.mjs",
    "shadow:sample": "node ./scripts/shadow-sample.mjs",
    "shadow:aggregate": "node ./scripts/shadow-aggregate.mjs",
    "api:cutover-readiness": "node ./scripts/api-cutover-readiness.mjs",
    "write:readiness": "node ./scripts/write-readiness.mjs",
    "write:rollback": "node ./scripts/write-rollback-smoke.mjs",
    "css:budget": "node ./scripts/css-budget.mjs",
    "css:unused-report": "node ./scripts/css-unused-report.mjs",
    "visual:consistency": "node ./scripts/visual-consistency.mjs",
    "visual:review": "node ./scripts/visual-review.mjs"
  },
  "dependencies": {
    "@tanstack/solid-query": "^5.101.0",
    "@tanstack/solid-router": "^1.170.11",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/solid-virtual": "^3.13.28",
    "lightweight-charts": "^5.2.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.4.0",
    "jsdom": "^27.3.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.59.1",
    "pngjs": "^7.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.5"
  }
}
