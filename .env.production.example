# Production resource-contention example.
# Copy the relevant values into the remote .env only during an authorized
# maintenance window after a read-only baseline and backup have been captured.
# This file is documentation; it is not loaded automatically by the app.

# Keep Web/API, MySQL, Redis, Go hot-read/scan, and the core runtime-worker online.
# Pause optional background pressure from autopilot, market review, analytics,
# backtest, ML, factor, data repair, research, and other low-priority tasks.
PLATFORM_AUTOPILOT_ENABLED=false
RUNTIME_LOW_PRIORITY_TASKS_PAUSED=true
MARKET_REVIEW_ENABLED=false
RUNTIME_STARTUP_CACHE_PREWARM_ENABLED=false
RUNTIME_STARTUP_HISTORY_PREWARM_ENABLED=false

# D5 embedded scheduler is intentionally not part of the stop profile.
# Enable it only after the full trading-day gate passes and the operator has
# explicitly approved the scheduler cutover window.
RUNTIME_WORKER_EMBED_SCHEDULER=false
RUNTIME_SCHEDULER_BACKGROUND_JOBS_ENABLED=true

# Optional D6 guard for sustained runtime-worker RSS near its container limit.
# Keep disabled until online evidence justifies enabling it.
RUNTIME_WORKER_RECYCLE_RSS_MB=0

# Optional small-host pool/profile anchors. Keep within the MySQL max_connections
# budget and validate with scripts/verify_platform_budget.py before rollout.
APP_WORKERS=1
WEB_DB_POOL_SIZE=4
WEB_DB_MAX_OVERFLOW=4
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=2
SCHEDULER_DB_POOL_SIZE=2
SCHEDULER_DB_MAX_OVERFLOW=2
