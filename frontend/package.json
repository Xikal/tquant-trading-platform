{
  "name": "a-share-t-quant-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "npm run lint && tsc -b && vite build",
    "build:native": "npm run lint && tsc -b && node ./scripts/build-native.mjs && node ./scripts/prepare-native-dist.mjs",
    "analyze": "npm run build:web && node ./scripts/bundle-report.mjs",
    "lint": "npm run lint:state && npm run check:refactor && npm run check:css",
    "lint:state": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "check:refactor": "node ./scripts/check-refactor-guard.mjs",
    "check:css": "node ./scripts/check-css-guard.mjs",
    "check:strategy-meta": "python3 ../scripts/sync_strategy_meta_fallback.py --check",
    "api:export": "cd .. && DATABASE_URL=${DATABASE_URL:-sqlite:///backend/data/t_quant.db} PYTHONPATH=backend:. backend/.venv/bin/python backend/scripts/export_openapi_schema.py --output docs/contracts/openapi.json",
    "api:generate": "openapi-typescript ../docs/contracts/openapi.json -o src/generated/api-types.ts",
    "api:check": "npm run api:export && npm run api:generate && npm run typecheck",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "smoke:responsive": "node ./scripts/smoke-responsive.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@babel/runtime": "7.29.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/core": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-virtual": "^3.13.24",
    "antd": "6.4.3",
    "antd-mobile": "5.42.3",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.59.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
